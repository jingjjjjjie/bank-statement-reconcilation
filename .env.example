# Folder containing the supporting documents and bank statement.
DOCUMENTS_PATH=../bank-statement-uploads

# Host upload folder; relative paths are resolved from the project folder.
# Use forward slashes for Windows paths, e.g. C:/Data/reconciliation/uploads.
UPLOADS_PATH=../bank-statement-uploads

# Host port for the dashboard.
DASHBOARD_PORT=8765
# Keep localhost-only by default. For trusted LAN access, use 0.0.0.0 and
# list this PC's LAN address with its port, e.g. 192.168.1.50:8765.
DASHBOARD_BIND_IP=127.0.0.1
DASHBOARD_ALLOWED_HOSTS=

# Codex CLI version verified with this container setup.
CODEX_VERSION=0.160.0

# Development includes coding-agent tools; use runtime for the slim image.
DOCKER_TARGET=development
